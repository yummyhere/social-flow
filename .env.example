# ==========================================
# SocialFlow Production Environment Configuration
# ==========================================

# Core Application Settings
APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT="3000"
DEFAULT_TIMEZONE="UTC"

# Security & Encryption
# JWT_SECRET: Secret used to sign user authentication tokens (min 32 chars)
JWT_SECRET="replace-with-a-secure-random-jwt-secret-key-min-32-characters"
# TOKEN_ENCRYPTION_KEY: 32-byte (64 hex characters or 32 raw chars) key for AES-256-GCM encryption of social media access tokens
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Meta Graph API Integration (Facebook Pages & Instagram Professional)
# Register your app at https://developers.facebook.com
META_APP_ID="YOUR_META_APP_ID"
META_APP_SECRET="YOUR_META_APP_SECRET"
META_API_VERSION="v21.0"
# Redirect URI must be added to your Facebook Login settings -> Valid OAuth Redirect URIs
META_REDIRECT_URI="http://localhost:3000/api/oauth/meta/callback"

# Database & Celery (For Django / Cloud Deployment)
DATABASE_URL="postgres://socialflow_user:socialflow_password@localhost:5432/socialflow_db"
REDIS_URL="redis://localhost:6379/0"
DJANGO_SECRET_KEY="django-insecure-replace-with-random-50-character-secret"

# Durable Media Storage (Local file storage or S3 compatible)
STORAGE_TYPE="local" # 'local' or 's3'
MEDIA_UPLOAD_DIR="./uploads"
# S3 Credentials (optional if STORAGE_TYPE='s3')
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_STORAGE_BUCKET_NAME=""
AWS_S3_REGION_NAME="us-east-1"
